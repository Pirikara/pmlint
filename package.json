{
  "name": "pmlint",
  "version": "0.1.0",
  "description": "Lint package-manager policy across JavaScript, Ruby, and Python repositories.",
  "type": "module",
  "bin": {
    "pmlint": "dist/index.js"
  },
  "main": "dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pmlint": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lint",
    "package-manager",
    "dependencies",
    "lockfile",
    "dependabot",
    "supply-chain"
  ],
  "license": "MIT",
  "dependencies": {
    "cac": "^7.0.0",
    "fast-glob": "^3.3.2",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.7.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "4.1.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
